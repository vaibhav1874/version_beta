# ==========================================
# Project JEEVAN — Environment Variables
# ==========================================
# Copy this file to .env and fill in values.
# NEVER commit the .env file with real secrets.

# --- Backend (FastAPI) ---
DATABASE_URL=sqlite:///./jeevan.db
UPLOAD_DIR=./uploads
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- AI Models (Hugging Face — auto-downloaded on first run) ---
IMAGE_MODEL_NAME=microsoft/resnet-50
SENTENCE_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
AI_CONFIDENCE_THRESHOLD=0.6
DUPLICATE_SIMILARITY_THRESHOLD=0.75
DUPLICATE_TIME_WINDOW_HOURS=48
DUPLICATE_DISTANCE_METERS=500

# --- Frontend (Vite — prefix with VITE_) ---
VITE_API_BASE_URL=http://localhost:8000/api
