# ========================
# Project JEEVAN .gitignore
# ========================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/build/
*.tsbuildinfo

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
!.env.example

# --- Database ---
*.db
*.sqlite
*.sqlite3

# --- Uploads & Generated ---
backend/uploads/*
!backend/uploads/.gitkeep

# --- AI Models (downloaded at runtime) ---
*.bin
*.pt
*.onnx
*.safetensors
models_cache/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Misc ---
*.bak
*.tmp
.cache/
